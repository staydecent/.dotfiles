#!/usr/bin/env bash
set -e
set -u

# courtesy of https://blog.nytsoi.net/2024/04/26/digital-retro-photography/

INPUT="${1}"
COLOURS="${2}"
OUTPUT_SMOL="${INPUT}.webp"
OUTPUT_BIG="${INPUT}-big.webp"

# Bash cannot assign to positional parameters with ':=', so use ':-' for defaults
SMOL_SIZE="${3:-640}"
BIG_SIZE="${4:-4096}"

magick "${INPUT}" -auto-orient -resize "${SMOL_SIZE}x${SMOL_SIZE}" -colors "${COLOURS}" png:- | cwebp -q 100 -m 6 -mt -lossless -progress -o "${OUTPUT_SMOL}" -- -
magick "${INPUT}" -auto-orient -resize "${SMOL_SIZE}x${SMOL_SIZE}" -colors "${COLOURS}" -filter point -resize "${BIG_SIZE}x${BIG_SIZE}" png:- | cwebp -q 100 -m 6 -mt -lossless -progress -o "${OUTPUT_BIG}" -- -
