#!/usr/bin/env sh

# https://github.com/benciks/dots/blob/master/.config/bspwm/bspwmrc

bspc monitor -d Browser Code Files

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config single_monocle 	      true

bspc config normal_border_color    "#19191C"
bspc config focused_border_color   "#202026"

bspc rule -a firefox desktop="^1"
bspc rule -a Thunar desktop="^3"
# bspc rule -a krita state=floating

picom -b &
polybar &
redshift
